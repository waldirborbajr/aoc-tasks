{
  "name": "Rust Power Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "skellock.just",
        "fill-labs.dependi",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "ms-vscode.hexeditor",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.checkOnSave": true,
        "rust-analyzer.cargo.allFeatures": true,
        "rust-analyzer.imports.granularity.group": "module",
        "rust-analyzer.procMacro.enable": true,
        "editor.formatOnSave": true,
        "editor.inlayHints.enabled": "on",
        "files.insertFinalNewline": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=${localWorkspaceFolderBasename}-sccache,target=/usr/local/cargo/sccache,type=volume",
    "source=${localWorkspaceFolderBasename}-target,target=/home/vscode/target-cache,type=volume"
  ],
  "remoteUser": "vscode",
  "onCreateCommand": "rustc --version && cargo --version",
  "postStartCommand": "echo '✅ Rust DevContainer pronto!' && rustc --version",
  "containerEnv": {
    "SCCACHE_DIR": "/usr/local/cargo/sccache",
    "SCCACHE_CACHE_SIZE": "50G"
  }
}
